# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/valo

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key

# Replicate API
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_TEXT_TO_VIDEO_MODEL=openai/text-to-video
REPLICATE_IMAGE_TO_VIDEO_MODEL=runway/image-to-video
REPLICATE_MULTIPLE_IMAGES_MODEL=cog/video-generator

# Storage (Optional)
STORAGE_TYPE=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=valo-videos
