generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\nmodel User {\n  id              String     @id @default(cuid())\n  email           String     @unique\n  password        String\n  name            String?\n  avatar          String?\n  tier            UserTier   @default(FREE)\n  createdAt       DateTime   @default(now())\n  updatedAt       DateTime   @updatedAt\n  videos          VideoJob[]\n  templates       VideoTemplate[]\n  presets         VideoPreset[]\n  watermarks      Watermark[]\n  @@map(\"users\")\n}\n\nenum UserTier {\n  FREE\n  PRO\n  ENTERPRISE\n}\n\nmodel VideoJob {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  type            VideoType\n  textPrompt      String?\n  imageUrl        String?\n  imageUrls       String[]\n  style           String?\n  startFrame      Int?\n  endFrame        Int?\n  duration        Int?\n  fps             Int?\n  resolution      Resolution?\n  aspectRatio     AspectRatio?\n  effects         String[]?\n  transitionType  TransitionType?\n  transitionDuration Int?\n  speed           Float?\n  backgroundMusic String?\n  voiceoverUrl    String?\n  volume          Int?\n  templateId      String?\n  template        VideoTemplate? @relation(fields: [templateId], references: [id])\n  presetId        String?\n  preset          VideoPreset?   @relation(fields: [presetId], references: [id])\n  watermarkId     String?\n  watermark       Watermark?     @relation(fields: [watermarkId], references: [id])\n  videoUrl        String?\n  thumbnailUrl    String?\n  status          JobStatus      @default(PENDING)\n  progress        Int            @default(0)\n  errorMessage    String?\n  replicateTaskId String?        @unique\n  fileSize        Int?\n  videoDuration   Float?\n  codec           String?\n  createdAt       DateTime       @default(now())\n  updatedAt       DateTime       @updatedAt\n  completedAt     DateTime?\n  analytics       VideoAnalytics?\n  @@index([userId])\n  @@index([status])\n  @@index([templateId])\n  @@index([createdAt])\n  @@map(\"video_jobs\")\n}\n\nenum VideoType {\n  TEXT_TO_VIDEO\n  IMAGE_TO_VIDEO\n  MULTIPLE_IMAGES_TO_VIDEO\n  TEXT_WITH_IMAGES_TO_VIDEO\n  TEXT_WITH_FRAME_RANGE\n}\n\nenum Resolution {\n  STANDARD\n  FULL_HD\n  ULTRA_HD\n}\n\nenum AspectRatio {\n  SIXTEEN_NINE\n  NINE_SIXTEEN\n  ONE_ONE\n  FOUR_THREE\n}\n\nenum TransitionType {\n  FADE\n  SLIDE\n  ZOOM\n  WIPE\n  CROSS_DISSOLVE\n  PUSH\n}\n\nenum JobStatus {\n  PENDING\n  PROCESSING\n  COMPLETED\n  FAILED\n  CANCELLED\n}\n\nmodel VideoTemplate {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  name            String\n  description     String?\n  category        TemplateCategory\n  thumbnail       String?\n  isPublic        Boolean  @default(false)\n  rating          Float?\n  usageCount      Int      @default(0)\n  duration        Int?\n  style           String?\n  effects         String[]?\n  transitionType  TransitionType?\n  transitionDuration Int?\n  speed           Float?\n  backgroundMusic String?\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  jobs            VideoJob[]\n  @@index([userId])\n  @@index([category])\n  @@map(\"video_templates\")\n}\n\nenum TemplateCategory {\n  MARKETING\n  SOCIAL_MEDIA\n  PRODUCT\n  OTHER\n}\n\nmodel VideoPreset {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  name            String\n  description     String?\n  resolution      Resolution\n  aspectRatio     AspectRatio\n  fps             Int\n  codec           String?\n  speed           Float\n  effects         String[]?\n  transitionType  TransitionType?\n  transitionDuration Int?\n  volume          Int?\n  isDefault       Boolean  @default(false)\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  jobs            VideoJob[]\n  @@index([userId])\n  @@map(\"video_presets\")\n}\n\nmodel Watermark {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  name            String\n  type            WatermarkType\n  content         String\n  position        WatermarkPosition\n  opacity         Int      @default(100)\n  scale           Float    @default(1.0)\n  color           String?\n  fontSize        Int?\n  fontFamily      String?\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  jobs            VideoJob[]\n  @@index([userId])\n  @@map(\"watermarks\")\n}\n\nenum WatermarkType {\n  TEXT\n  IMAGE\n  LOGO\n}\n\nenum WatermarkPosition {\n  TOP_LEFT\n  TOP_CENTER\n  TOP_RIGHT\n  CENTER_LEFT\n  CENTER\n  CENTER_RIGHT\n  BOTTOM_LEFT\n  BOTTOM_CENTER\n  BOTTOM_RIGHT\n}\n\nmodel VideoAnalytics {\n  id              String   @id @default(cuid())\n  jobId           String   @unique\n  job             VideoJob @relation(fields: [jobId], references: [id], onDelete: Cascade)\n  views           Int      @default(0)\n  clicks          Int      @default(0)\n  shares          Int      @default(0)\n  likes           Int      @default(0)\n  avgWatchTime    Float?\n  engagementRate  Float?\n  loadTime        Float?\n  playbackErrors  Int      @default(0)\n  completionRate  Float?\n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  @@map(\"video_analytics\")\n}\n"